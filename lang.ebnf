top =  { elem } ;

elem =
    declaration
    | function declaration
    | preprocessor ;

declaration =
    variable declaration
    | enum declaration
    | struct declaration ;

variable declaration = { specifier }, type, declarator, { ",", declarator }, ";" ;

declarator = identifier, [ assigner, statement ] ;

function declaration = 
    type, identifier, "(", argument list, ")", ";"
    | type, identifier, "(", argument list, ")",  "{",
        function body,
    "}" ;

enum declaration = "enum", [ identifier ], "{",
        { enum element },
    "}", [ identifier ], ";" ;

enum element = identifier, [ "=", number | identifier ] ;

struct declaration = "struct", [ identifier ], "{",
        { struct element },
    "}", [ identifier ], ";" ;

struct element = declaration ;

argument list = [argument, { ",", argument } ], [ "..." ] ;

argument = type, [ identifier ] ;

function body = { expr } ;

expr =
    declaration,
    | assignment, ";"
    | function call, ";"
    | do while
    | for
    | goto
    | if
    | switch
    | while ;

assignment = identifier, assigner, statement ;

assigner = "=" | "*=" | "/=" | "%=" | "+=" | "-=" | ">>=" | "<<=" | "&=" | "^=" | "|=" ;

function call = identifier, "(", [ statement, { ",", statement } ], ")" ;

do while = "do", "{", 
        { expr },
    "}", "while", "(", condition, ")", ";" ;

for = "for", "(", variable declaration, ";", condition, ";", ( statement | assignment ), ")", "{",
        { expr },
    "}" ;

goto = "goto", identifier, ";" ;

if = "if", "(", condition, ")", "{",
        { expr },
    "}",
    { else if },
    [ else ] ;

else if = "else if", "(", condition, ")", "{",
        { expr },
    "}" ;

else = "else", "{",
        { expr },
    "}" ;

switch = "switch", "(", statement, ")", "{",
        { case },
    "}" ;

case = "case", value, "{",
        { expr },
    "}" ;

while = "while", "(", condition, ")", "{",
        { expr },
    "}" ;

preprocessor =
    define
    | undef
    | preproc if
    | error 
    | warning
    | line
    | pragma ;

define = "#define", identifier, [ identifier | number ] ;

undef = "#undef", identifier ;

preproc if = 
    ["#if", [define condition] | "#ifdef" | "#ifndef" ], condition, { expr }, [ 
        "#else", { expr }
        | "#elif", define condition | condition, { expr }
    ], "#endif" ;

error = "#error", ? any char ?, "\n" ;

warning = "#warning", ? any char ?, "\n" ;

line = "#line", number ;

pragma = "#pragma", ? any char ?, "\n" ; 

define condition = ["!"], "defined", "(", identifier, ")" ;


type = identifier ;

specifier = identifier ;

condition =
    ["!"], condition term, { conditional, condition term } ;

condition term =
    ["("], statement, [")"]
    | ["("], condition, [")"] ;

statement = value, { operator, value } ;

operator = "*" | "/" | "%" | "+" | "-" | "<<" | ">>" | "&" | "^" | "|" ;
unary modifier = "++" | "--" ;
unary operator = "+" | "-" | "!" | "~" ;
pointer operator = "*" | "&" ;
conditional = "==" | "!=" | ">" | ">=" | "<" | "<=" | "&&" | "||" ;

value =
    { unary operator | unary modifier | pointer operator | cast }, identifier, [ unary modifier ]
    | { unary operator | cast }, number ;

cast = "(", type, ")" ;

identifier = ? /[a-zA-Z_][a-z-A-Z0-9_]*$/ ? ;

number = "0x", ? /[0-9a-fA-F]+/ ?
    | "0b", ? /[0-1]+/ ?
    | "0", ? /[0-7]+/ ?
    | ? /[0-9]+/ ? ;
