program = { decl }, EOF
;

decl = ? empty ?
    | var_decl, ";"
    | func_proto, ";"
    | func_decl
;

var_decl = type, ident, { "[", [ expr ], "]" }, [ "=", expr ]
;

func_proto = type, ident, "(", [ arg_list ], ")"
;

arg_list = arg, { ",", arg }
;

arg = type, ident, [ "=", number ]
;

func_decl = func_proto, "{", { stmt }, "}"
;

stmt
    = expr, ";"
    | break
    | do_while
    | for
    | goto
    | if
    | return
    | switch
    | while,
    | "{", { stmt }, "}"
;

break = "break", ";"
;

do_while
    = "do", stmt, "while", "(", expr, ")", ";"
;

for
    = "for", "(",
        [ var_decl | expr ], ";",
        [ expr ], ";",
        [ expr ],
    ")", stmt,
;

goto = "goto", ident, ";"
;

if
    = "if", "(", expr, ")", stmt,
    { "else", "if", "(", expr, ")", stmt },
    [ "else", stmt ]
;

return = "return", [ expr ], ";"
;

switch
    = "switch", "(", expr, ")", "{",
        { case },
        [ default ],
    "}"
;

case
    = "case", expr, ":", { stmt }
;

default
    = "default", ":", { stmt }
;

while
    = "while", "(", expr, ")", { stmt }
;

expr = expr_15
;

expr_15
    = expr_14, { ",", expr_14 }
;

expr_14
    = expr_13, [ (
        "=" |
        "+=" | "-=" | "*=" | "/=" | "%=" |
        "<<=" | ">>=" | "&=" | "^=" | "|="
    ), expr_14 ]
;

expr_13
    = expr_12, [ "?", expr_12, ":", expr_13 ]
;

expr_12
    = expr_11, { "||", expr_11 }
;

expr_11
    = expr_10, { "&&", expr_10 }
;

expr_10
    = expr_9, { "|", expr_9 }
;

expr_9
    = expr_8, { "^", expr_8 }
;

expr_8
    = expr_7, { "&", expr_7 }
;

expr_7
    = expr_6, { ( "==" | "!=" ), expr_6 }
;

expr_6
    = expr_5, { ( "<" | "<=" | ">" | ">=" ), expr_5 }
;

expr_5
    = expr_4, { ( "<<" | ">>" ), expr_4 }
;

expr_4
    = expr_3, { ( "+" | "-" ), expr_3 }
;

expr_3
    = expr_2, { ( "*" | "/" | "%" ), expr_2 }
;

expr_2
    = expr_1
    | [ "++" | "--" |
        "+" | "-" |
        "!" | "~" |
        "*" | "&"
    ], expr_2
;

expr_1
    = expr_0, { (
        "++" | "--" |
        ( "(", [ expr, { ",", expr } ], ")" ) |
        ( "[", expr, "]" )
    ) }
;

expr_0
    = ident
    | number
    | "(", expr, ")"
;

type = ident, { "*" }
;

ident = ? /[a-zA-Z_][a-zA-Z0-9_]*/ ?
;

number = ? /[0-9]+/ ?
;

EOF = ? EOF ?
;