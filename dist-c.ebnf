program = { decl }, EOF
;

decl = ? empty ?
    | var_decl
    | func_proto
    | func_decl
;

var_decl = type, ident, [ "=", expr ]
;

func_proto = "func", ident, "(", arg_list, ")"
;

arg_list = [arg, {",", arg}]
;

arg = type, ident, [ "=", number ]
;

func_decl = func_proto, "{", { stmt }, "}"
;

stmt = 
;

expr = term, { ( "+" | "-" ), term }
;

term = factor, { ( "*" | "/" ), factor }
;

factor
    = ident
    | number
    | "(", expr, ")"
;

type = ident
;

ident = ? /[a-bA-B_][a-bA-B0-9_]+/ ?
;

number = ? /[0-9]+/ ?
;

EOF = ? EOF ?
;